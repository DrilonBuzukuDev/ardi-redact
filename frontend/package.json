{
  "name": "ardi-redact-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src index.html package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check src index.html package.json tsconfig.json vite.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ardi/designsystem": "file:vendor/designsystem",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@mantine/core": "^9.5.2",
    "@mantine/dates": "^9.5.2",
    "@mantine/dropzone": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "dayjs": "^1.11.0",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  }
}
